{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/identity-guard.mjs"],
            "timeout": 30,
            "statusMessage": "ASEN identity guard"
          }
        ]
      }
    ]
  }
}
