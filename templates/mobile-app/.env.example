# Names only. Real values go in the hosting provider's settings or your local .env (never committed).
# Anything with EXPO_PUBLIC_ ships inside the app: publishable values only
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (EAS secrets)
SENTRY_AUTH_TOKEN=
